{
  "name": "@security-survey/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.mjs",
  "description": "安防勘点设计工具 - 桌面端 Electron 应用",
  "author": "gztxt",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:dir": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "smoke": "xvfb-run -a node scripts/smoke/run.cjs",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@security-survey/cad-parser": "workspace:*",
    "@security-survey/cad-renderer": "workspace:*",
    "@security-survey/device-lib": "workspace:*",
    "@security-survey/exporter": "workspace:*",
    "@security-survey/shared-types": "workspace:*",
    "@security-survey/wiring-engine": "workspace:*",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "element-plus": "^2.9.0",
    "handlebars": "^4.7.8",
    "idb": "^8.0.0",
    "jspdf": "^2.5.0",
    "jszip": "^3.10.0",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^1.0.0",
    "pdfjs-dist": "^4.2.0",
    "pdfkit": "^0.15.0",
    "pinia": "^2.1.0",
    "shepherd.js": "^11.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/d3-force": "^3.0.0",
    "@types/dagre": "^0.7.54",
    "@types/handlebars": "^4.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/pdfkit": "^0.13.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.41.0",
    "sass": "^1.77.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^1.2.0",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "com.security-survey.desktop",
    "productName": "安防勘点设计工具",
    "copyright": "Copyright © 2024 安防勘点设计工具",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main/**/*",
      "dist-electron/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.bak-*"
        ]
      },
      {
        "from": "resources/oda",
        "to": "oda",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "安防勘点设计工具"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  }
}
