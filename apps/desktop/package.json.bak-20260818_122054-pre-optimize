{
  "name": "@security-survey/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:dir": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@security-survey/shared-types": "workspace:*",
    "@security-survey/cad-parser": "workspace:*",
    "@security-survey/cad-renderer": "workspace:*",
    "@security-survey/device-lib": "workspace:*",
    "@security-survey/wiring-engine": "workspace:*",
    "@security-survey/exporter": "workspace:*",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "idb": "^8.0.0",
    "lodash-es": "^4.17.21",
    "jszip": "^3.10.0",
    "xlsx": "^0.18.5",
    "pdfjs-dist": "^4.2.0",
    "dagre": "^0.8.5",
    "d3-force": "^3.0.0",
    "jspdf": "^2.5.0",
    "pdfkit": "^0.15.0",
    "handlebars": "^4.7.8",
    "shepherd.js": "^11.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "@types/lodash-es": "^4.17.12",
    "@types/dagre": "^0.8.4",
    "@types/d3-force": "^3.0.0",
    "@types/handlebars": "^4.1.0",
    "playwright": "^1.41.0",
    "@playwright/test": "^1.41.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0"
  },
  "build": {
    "appId": "com.security-survey.desktop",
    "productName": "安防勘点设计工具",
    "copyright": "Copyright © 2024 安防勘点设计工具",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": ["**/*"]
      },
      {
        "from": "resources/oda",
        "to": "oda",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "安防勘点设计工具"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "security-survey",
      "repo": "desktop"
    }
  }
}