// Electron 主进程入口
//
// 必须在任何 workspace 包（如 @security-survey/cad-parser → dxf-parser 的 UMD bundle，
// 内嵌 loglevel 模块会检查 window）加载之前注入最小 DOM polyfill，
// 否则 Node 主进程环境会在 require/import 时抛出 `ReferenceError: window is not defined`。
//
// 注意：本模块最终被 vite 打包为 **CJS**，polyfill 才能在模块顶层同步执行，
// 不被 ESM import 的 hoist 提前到其它副作用代码之后。
function installMainProcessDomPolyfill(): void {
  const g: any = globalThis as any;
  if (typeof g.window === 'undefined') g.window = g;
  if (typeof g.self === 'undefined') g.self = g;
  if (typeof g.document === 'undefined') {
    g.document = { cookie: '', createElement: () => ({}), addEventListener: () => {} };
  }
  if (typeof g.navigator === 'undefined') {
    g.navigator = { userAgent: 'electron-main', language: 'zh-CN' };
  }
  if (typeof g.localStorage === 'undefined') {
    const store = new Map<string, string>();
    g.localStorage = {
      getItem: (k: string) => (store.has(k) ? store.get(k)! : null),
      setItem: (k: string, v: string) => { store.set(k, String(v)); },
      removeItem: (k: string) => { store.delete(k); },
      clear: () => { store.clear(); },
      key: (i: number) => Array.from(store.keys())[i] ?? null,
      get length() { return store.size; },
    };
  }
}
installMainProcessDomPolyfill();

import { app, BrowserWindow, ipcMain, dialog, shell, protocol } from 'electron';
import { join, resolve, sep, parse, dirname, basename } from 'path';
import { existsSync, readFileSync, writeFileSync, mkdirSync, copyFileSync, mkdtempSync } from 'fs';
import { spawn } from 'child_process';
import { tmpdir } from 'os';
import { randomUUID } from 'crypto';

// 工作区包：设备库 / CAD 解析器（主进程可用）
import { DeviceLibrary, BUILTIN_DEVICES } from '@security-survey/device-lib';
